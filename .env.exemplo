# Opcao recomendada no Vercel quando voce nao quer expor a senha do Postgres:
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
VITE_SUPABASE_ANON_KEY="[ANON_PUBLIC_KEY]"

# Opcao local/direta via PostgreSQL. Se definida, ela tem prioridade sobre o modo REST acima.
# Para conexao direta (requer IPv6): DATABASE_URL="postgresql://postgres:[SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres"
# Para conexao via pooler (compativel com IPv4): DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-1-[REGIAO].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

HOST=127.0.0.1
PORT=3001

# Opcional. Deixe vazio para funcionamento sem integracao Tiny.
TINY_TOKEN=
