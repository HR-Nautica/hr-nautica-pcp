# Desenvolvimento local. Copie para .env.local; nunca grave valores reais no Git.
HOST=127.0.0.1
PORT=3001

# PostgreSQL direto (recomendado para testar todas as rotas transacionais).
DATABASE_URL=postgresql://usuario:SENHA@127.0.0.1:5432/hr_nautica_dev
DATABASE_STRICT_MODE=false
DATABASE_SSL_MODE=disable
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Alternativa legada para rotas nao transacionais quando DATABASE_URL nao existe.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHAVE_FORA_DO_GIT
VITE_SUPABASE_ANON_KEY=CHAVE_PUBLICA

# Mesmo valor forte no Vite local e na API. Em producao, Caddy e API leem o
# valor exclusivo de /etc/hr-nautica/production.env.
PROXY_SHARED_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_COM_32_OU_MAIS_BYTES

# Em HTTPS interno/produção e true; em desenvolvimento HTTP local, false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=hrn_session_dev
AUTH_SESSION_HOURS=8

# Somente durante a execucao manual de auth:bootstrap-admin.
INITIAL_ADMIN_USERNAME=lucas

AUDIT_CLEANUP_ENABLED=false
AUDIT_RETENTION_DAYS=30
TINY_TOKEN=
