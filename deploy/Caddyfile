http://{$ERP_INTERNAL_HOST:192.168.100.180} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy app:3001 {
		# O navegador nunca recebe este segredo; Caddy sobrescreve o header.
		header_up X-HRN-Proxy-Secret {$PROXY_SHARED_SECRET}
		header_up X-Forwarded-Proto http
	}
}
