# Copiar para /etc/hr-nautica/homologation.env com permissao 600.
ERP_INTERNAL_HOST=erp-homolog.hrnautica.internal
ERP_HTTPS_BIND_IP=192.168.100.180
ERP_HTTPS_PORT=8443
ERP_TLS_CERT_DIR=/etc/hr-nautica/tls/homologation
ERP_IMAGE=hr-nautica-pcp:homolog-bootstrap
CADDY_IMAGE=caddy:2.11.7-alpine

HOMOLOG_DATABASE_NETWORK=SUBSTITUIR_PELA_REDE_DOCKER_ISOLADA
DATABASE_URL=postgresql://hr_nautica_homolog:SENHA_FORA_DO_GIT@HOST_POSTGRES_HOMOLOG:5432/hr_nautica_homolog
DATABASE_CONNECT_TIMEOUT_MS=10000
PROXY_SHARED_SECRET=SUBSTITUIR_POR_OUTRO_SEGREDO_ALEATORIO_COM_32_OU_MAIS_BYTES
AUTH_SESSION_HOURS=8
AUTH_COOKIE_NAME=hrn_homolog_session
TINY_TOKEN=
