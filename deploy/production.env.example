# Copiar para /etc/hr-nautica/production.env com permissao 600. Nunca versionar valores reais.
ERP_INTERNAL_HOST=erp.hrnautica.internal
ERP_HTTPS_BIND_IP=192.168.100.180
ERP_HTTPS_PORT=443
ERP_TLS_CERT_DIR=/etc/hr-nautica/tls/production

# A imagem e sobrescrita pelo deploy para o SHA exato.
ERP_IMAGE=hr-nautica-pcp:bootstrap
CADDY_IMAGE=caddy:2.11.7-alpine

# Usuario exclusivo do ERP no PostgreSQL operacional da rede supabase_default.
# Confirmar o hostname real do servico de banco antes da ativacao.
DATABASE_URL=postgresql://hr_nautica_app:SENHA_FORA_DO_GIT@supabase-db:5432/postgres
DATABASE_CONNECT_TIMEOUT_MS=10000

# Gerar com: openssl rand -base64 48
PROXY_SHARED_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_COM_32_OU_MAIS_BYTES
AUTH_SESSION_HOURS=8
AUTH_COOKIE_NAME=hrn_session

# Opcional; manter vazio se a integracao Tiny nao for usada.
TINY_TOKEN=
